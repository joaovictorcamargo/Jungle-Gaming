{
  "name": "nft-marketplace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_ENABLE_MOCKS=true vite",
    "build": "tsc -b && VITE_ENABLE_MOCKS=true vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lighthouse": "node lighthouse/run.mjs",
    "test:e2e:report": "playwright show-report",
    "assets": "node scripts/generate-assets.mjs",
    "build:pages": "tsc -b && BASE_PATH=/Jungle-Gaming/ VITE_ENABLE_MOCKS=true vite build --outDir dist-pages && cp dist-pages/index.html dist-pages/404.html && touch dist-pages/.nojekyll"
  },
  "dependencies": {
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mswjs/socket.io-binding": "^0.2.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
