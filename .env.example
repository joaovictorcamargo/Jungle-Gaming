# Ativa a camada de rede simulada (MSW REST + Socket.IO). O script `build` já define VITE_ENABLE_MOCKS=true
# porque a build de demonstração depende dos mocks. Use "false" apenas para apontar o app a um backend real.
VITE_ENABLE_MOCKS=true
# Opcional (apenas ambientes sem acesso ao CDN do Playwright/Chrome): caminho de um Chromium já instalado.
# CHROMIUM_PATH=/caminho/para/chrome
# CHROME_PATH=/caminho/para/chrome   # usado pelo Lighthouse (chrome-launcher)
